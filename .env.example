ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
FORCESIGNAL_WEB_ORIGIN=http://localhost:6297
VITE_API_BASE_URL=http://localhost:8080

# Where matches are kept so a restart resumes the game rather than ending it. The compose file
# already sets this to a path on a named volume; set it here only to move the file somewhere else.
# Leaving it unset anywhere keeps matches in memory, which is fine for a throwaway session and
# loses everything on restart.
# The API reads either Persistence__MatchDatabasePath (what docker-compose.yml sets) or the shorter
# FORCESIGNAL_MATCH_DB; the first one found wins.
# FORCESIGNAL_MATCH_DB=/var/lib/forcesignal/matches.db
