# Copy to .env and edit before deploying. Every name here is one docker-compose.yml interpolates,
# so a value set in .env reaches the stack. Compose does not hand .env to a container by itself -
# it only substitutes it into the compose file - so a name that is not referenced there does
# nothing at all, however plausible it looks. scripts/check-deployment-config.py holds the two
# files to each other so that cannot happen quietly.

# Public web origin allowed to call the API. Compose reads it into Cors__AllowedOrigins__0, and the
# API also reads this name directly - so it works the same when you run the API without compose,
# which is what FORCESIGNAL_MATCH_DB and the two FORCESIGNAL_FEATURES_ names already did.
FORCESIGNAL_WEB_ORIGIN=http://localhost:6297

# Public API origin baked into the static web build, and into the web container's CSP.
VITE_API_BASE_URL=http://localhost:8080

# Where matches are kept so a restart resumes the game rather than ending it. The default is a path
# on the named volume the compose file mounts, which is what makes a restart survivable; set this
# only to move the file somewhere else you have mounted. A path the API cannot open is not fatal -
# it falls back to memory, readiness says so, and every game is lost at the next restart.
# FORCESIGNAL_MATCH_DB=/var/lib/forcesignal/matches.db

# True only when something you control writes X-Forwarded-For in front of the API. It is a claim any
# caller can make, so trusting it when there is no proxy lets one client wear every other client's
# rate limit. Leave it unset when the API is reached directly.
# FORCESIGNAL_TRUST_FORWARDED_HEADERS=true

# The ground-combat engines, off by default. Either may be half-finished at any given moment, which
# is the whole reason they are switched rather than always present.
# FORCESIGNAL_FEATURES_STARGRUNT=true
# FORCESIGNAL_FEATURES_DIRTSIDE=true
