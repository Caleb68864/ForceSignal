<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The repo restores from nuget.org and nothing else, whatever feeds the machine happens to have
    configured. Central package management refuses to guess between sources, and a build that
    depends on a private feed being reachable is not a build anyone else can run.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
